.venv/
__pycache__/
*.pyc

# what cargo produces; every artifact is rebuilt from core/ and native/
target/

# 167 MB, and feedback_table.py rebuilds it from the two word lists.  The rest
# of data/derived/ is a few hundred KB of index maps and is kept: they are what
# make the table readable, and they cost nothing to store.
data/derived/feedback_table.npy

# What build_site.sh assembles.  Every file in it is generated, and it would
# normally be ignored -- it is committed because Vercel deploys this repo by
# cloning it, and building it there would mean installing Rust on every deploy.
# So it is a build artifact kept for the deploy, and rebuilt before each one.
site/.vercel/
